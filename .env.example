# Local development only. Copy this file to .env and change values if needed.
WP_PORT=8083
WP_URL=https://ormas.dev.inteli-dev.ru

# UID/GID used by the Composer container so that vendor/ stays owned by you.
LOCAL_UID=1000
LOCAL_GID=1000

DB_NAME=ormas
DB_USER=ormas
DB_PASSWORD=ormas
DB_ROOT_PASSWORD=ormas-root

WP_TITLE="ORMAS Local"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

MAILPIT_PORT=8026
